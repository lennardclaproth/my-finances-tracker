# Frontend runtime configuration.
# Copy to `.env` (or run `make web-env`) to point the SvelteKit app at the live Go backend.
# With no `.env` (or VITE_USE_MOCKS unset and VITE_API_URL empty) the UI runs standalone
# against mock fixtures — no backend required.

# Set to false to call the real backend; true forces mock fixtures.
VITE_USE_MOCKS=false

# Base URL of the Go API. No trailing slash, no `/api` prefix.
# Must match apps/api/config.yaml `server.port` (default 6060).
VITE_API_URL=http://localhost:6060
