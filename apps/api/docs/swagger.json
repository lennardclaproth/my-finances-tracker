                    {
                        "type": "file",
                        "description": "CSV file containing transaction data",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "UUID of the vendor to import transactions for",
                        "name": "vendor_id",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "UUID of the account (required for brokerage vendors)",
                        "name": "account_id",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Import ID of the created import job",
